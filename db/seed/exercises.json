      "primary": ["latissimus_dorsi"], "secondary": ["biceps_brachii", "rhomboids", "teres_major"], "stabilizer": [] },
    { "id": "lat_pulldown_neutral", "label_fr": "Tirage vertical prise neutre", "equipment": "cable", "mechanic": "compound",
      "cues": "Prise serrée en marteau. Plus confortable pour l'épaule, plus d'amplitude sur le dorsal.",
      "primary": ["latissimus_dorsi"], "secondary": ["biceps_brachii", "teres_major"], "stabilizer": [] },
    { "id": "barbell_row", "label_fr": "Rowing barre buste penché", "equipment": "barbell", "mechanic": "compound", "bar_weight_kg": 20,
      "cues": "Buste à 45°, dos plat verrouillé. Barre vers le nombril, pas vers le sternum.",
      "primary": ["latissimus_dorsi", "rhomboids"], "secondary": ["trapezius_lower", "biceps_brachii", "deltoid_posterior"], "stabilizer": ["erector_spinae"] },
    { "id": "pendlay_row", "label_fr": "Rowing Pendlay", "equipment": "barbell", "mechanic": "compound", "bar_weight_kg": 20,
      "cues": "Buste parallèle au sol, barre reposée au sol entre chaque rep. Explosif à la montée.",
      "primary": ["latissimus_dorsi", "rhomboids"], "secondary": ["trapezius_lower", "deltoid_posterior"], "stabilizer": ["erector_spinae"] },
    { "id": "dumbbell_row", "label_fr": "Rowing haltère unilatéral", "equipment": "dumbbell", "mechanic": "compound", "is_unilateral": true,
      "cues": "Un genou et une main sur le banc. Tire le coude vers la hanche, pas vers l'épaule.",
      "primary": ["latissimus_dorsi"], "secondary": ["rhomboids", "biceps_brachii", "teres_major"], "stabilizer": ["obliques"] },
    { "id": "t_bar_row", "label_fr": "Rowing T-bar", "equipment": "barbell", "mechanic": "compound",
      "cues": "Poitrine haute, tire jusqu'au contact des plaques avec le torse.",
