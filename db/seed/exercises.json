    { "id": "rear_delt_fly_dumbbell", "label_fr": "Oiseau haltères", "equipment": "dumbbell", "mechanic": "isolation",
      "cues": "Buste penché à 90°. Écarte sans serrer les omoplates, sinon ce sont les rhomboïdes qui bossent.",
      "primary": ["deltoid_posterior"], "secondary": ["rhomboids", "trapezius_lower"], "stabilizer": ["erector_spinae"] },
    { "id": "reverse_pec_deck", "label_fr": "Butterfly inversé", "equipment": "machine", "mechanic": "isolation",
