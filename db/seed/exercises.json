      "primary": ["deltoid_lateral", "trapezius_upper"], "secondary": ["biceps_brachii"], "stabilizer": [] },
    { "id": "shrug_dumbbell", "label_fr": "Shrug haltères", "equipment": "dumbbell", "mechanic": "isolation",
