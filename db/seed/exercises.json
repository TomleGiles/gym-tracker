      "primary": ["deltoid_posterior"], "secondary": ["rhomboids", "trapezius_lower"], "stabilizer": [] },
    { "id": "face_pull", "label_fr": "Face pull", "equipment": "cable", "mechanic": "isolation",
      "cues": "Corde à hauteur de visage, mains qui finissent au-dessus des coudes. Le meilleur entretien d'épaule.",
      "primary": ["deltoid_posterior"], "secondary": ["infraspinatus", "trapezius_lower", "rhomboids"], "stabilizer": [] },
    { "id": "upright_row", "label_fr": "Rowing menton", "equipment": "barbell", "mechanic": "compound", "bar_weight_kg": 20,
