    { "id": "lateral_raise_cable", "label_fr": "Élévations latérales poulie", "equipment": "cable", "mechanic": "isolation", "is_unilateral": true,
      "cues": "Poulie derrière le corps : tension constante, y compris en bas du mouvement.",
