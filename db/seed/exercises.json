    { "id": "dumbbell_pullover", "label_fr": "Pull-over haltère", "equipment": "dumbbell", "mechanic": "isolation",
      "cues": "Allongé en travers du banc, hanches basses. Étirement maximal derrière la tête.",
      "primary": ["latissimus_dorsi"], "secondary": ["pectoralis_major", "serratus_anterior", "triceps_brachii"], "stabilizer": [] },
    { "id": "deadlift_conventional", "label_fr": "Soulevé de terre", "equipment": "barbell", "mechanic": "compound", "bar_weight_kg": 20,
