      "primary": ["latissimus_dorsi", "rhomboids"], "secondary": ["trapezius_lower", "biceps_brachii", "deltoid_posterior"], "stabilizer": [] },
    { "id": "chest_supported_row", "label_fr": "Rowing buste calé", "equipment": "machine", "mechanic": "compound",
