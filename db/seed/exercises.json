      "primary": ["deltoid_anterior"], "secondary": ["triceps_brachii", "quadriceps", "trapezius_upper"], "stabilizer": ["rectus_abdominis"] },
    { "id": "lateral_raise_dumbbell", "label_fr": "Élévations latérales haltères", "equipment": "dumbbell", "mechanic": "isolation",
      "cues": "Monte jusqu'à l'horizontale, pas plus. Petit doigt légèrement plus haut que le pouce.",
