  "exercises": [
    { "id": "bench_press_barbell", "label_fr": "Développé couché barre", "equipment": "barbell", "mechanic": "compound", "bar_weight_kg": 20,
      "cues": "Omoplates serrées et basses. Pieds ancrés au sol. Barre au bas des pecs, coudes à 45°.",
      "primary": ["pectoralis_major"], "secondary": ["triceps_brachii", "deltoid_anterior"], "stabilizer": ["serratus_anterior"] },
    { "id": "bench_press_dumbbell", "label_fr": "Développé couché haltères", "equipment": "dumbbell", "mechanic": "compound",
      "cues": "Descends plus bas qu'à la barre. Poignets neutres, haltères qui se rapprochent sans se toucher en haut.",
      "primary": ["pectoralis_major"], "secondary": ["triceps_brachii", "deltoid_anterior"], "stabilizer": ["infraspinatus"] },
    { "id": "incline_bench_press_barbell", "label_fr": "Développé incliné barre", "equipment": "barbell", "mechanic": "compound", "bar_weight_kg": 20,
      "cues": "Banc à 30°, pas plus : au-delà l'épaule prend tout. Barre à hauteur de clavicule.",
      "primary": ["pectoralis_major", "deltoid_anterior"], "secondary": ["triceps_brachii"], "stabilizer": [] },
    { "id": "incline_bench_press_dumbbell", "label_fr": "Développé incliné haltères", "equipment": "dumbbell", "mechanic": "compound",
      "cues": "30°. Amplitude complète, coudes sous les poignets tout du long.",
      "primary": ["pectoralis_major", "deltoid_anterior"], "secondary": ["triceps_brachii"], "stabilizer": ["infraspinatus"] },
    { "id": "decline_bench_press_barbell", "label_fr": "Développé décliné barre", "equipment": "barbell", "mechanic": "compound", "bar_weight_kg": 20,
      "cues": "Barre au niveau du sternum bas. Cale les jambes avant de décrocher.",
      "primary": ["pectoralis_major"], "secondary": ["triceps_brachii"], "stabilizer": [] },
    { "id": "chest_press_machine", "label_fr": "Développé machine", "equipment": "machine", "mechanic": "compound",
      "cues": "Règle le siège pour que les poignées soient au niveau des tétons. Ne verrouille pas les coudes.",
      "primary": ["pectoralis_major"], "secondary": ["triceps_brachii", "deltoid_anterior"], "stabilizer": [] },
    { "id": "pec_deck", "label_fr": "Butterfly (pec deck)", "equipment": "machine", "mechanic": "isolation",
      "cues": "Coudes légèrement fléchis et figés. Cherche le contact, pas le claquement.",
      "primary": ["pectoralis_major"], "secondary": ["deltoid_anterior"], "stabilizer": [] },
    { "id": "cable_fly_mid", "label_fr": "Écarté à la poulie vis-à-vis", "equipment": "cable", "mechanic": "isolation",
      "cues": "Un pas en avant pour garder la tension en position haute. Mains qui se croisent devant le sternum.",
      "primary": ["pectoralis_major"], "secondary": ["deltoid_anterior"], "stabilizer": ["serratus_anterior"] },
    { "id": "cable_fly_low_to_high", "label_fr": "Écarté poulie basse vers haut", "equipment": "cable", "mechanic": "isolation",
      "cues": "Trajectoire montante vers le menton. Cible le faisceau claviculaire.",
      "primary": ["pectoralis_major"], "secondary": ["deltoid_anterior"], "stabilizer": [] },
    { "id": "dumbbell_fly", "label_fr": "Écarté couché haltères", "equipment": "dumbbell", "mechanic": "isolation",
      "cues": "Arc de cercle large, coudes fixes. Arrête la descente au niveau du banc.",
      "primary": ["pectoralis_major"], "secondary": ["deltoid_anterior"], "stabilizer": [] },
    { "id": "push_up", "label_fr": "Pompes", "equipment": "bodyweight", "mechanic": "compound",
      "cues": "Corps gainé d'un bloc. Mains sous les épaules, coudes à 45°.",
      "primary": ["pectoralis_major"], "secondary": ["triceps_brachii", "deltoid_anterior"], "stabilizer": ["rectus_abdominis", "serratus_anterior"] },
    { "id": "dip_chest", "label_fr": "Dips prise large (pectoraux)", "equipment": "bodyweight", "mechanic": "compound",
      "cues": "Buste penché en avant, jambes légèrement devant. Descends jusqu'à l'étirement, pas plus.",
      "primary": ["pectoralis_major"], "secondary": ["triceps_brachii", "deltoid_anterior"], "stabilizer": ["serratus_anterior"] },

    { "id": "pull_up", "label_fr": "Traction pronation", "equipment": "bodyweight", "mechanic": "compound",
      "cues": "Épaules basses avant de tirer. Amène le sternum vers la barre, pas le menton.",
      "primary": ["latissimus_dorsi"], "secondary": ["biceps_brachii", "teres_major", "trapezius_lower", "rhomboids"], "stabilizer": ["forearm_flexors", "rectus_abdominis"] },
    { "id": "chin_up", "label_fr": "Traction supination", "equipment": "bodyweight", "mechanic": "compound",
      "cues": "Prise largeur d'épaules. Plus de biceps qu'en pronation, amplitude plus facile.",
      "primary": ["latissimus_dorsi", "biceps_brachii"], "secondary": ["teres_major", "rhomboids"], "stabilizer": ["forearm_flexors"] },
    { "id": "lat_pulldown_wide", "label_fr": "Tirage vertical prise large", "equipment": "cable", "mechanic": "compound",
