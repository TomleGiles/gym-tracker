      "primary": ["rhomboids", "latissimus_dorsi"], "secondary": ["trapezius_lower", "deltoid_posterior", "biceps_brachii"], "stabilizer": [] },
    { "id": "straight_arm_pulldown", "label_fr": "Pull-over à la poulie haute", "equipment": "cable", "mechanic": "isolation",
      "cues": "Bras quasi tendus, arc de cercle jusqu'aux cuisses. Le seul isolant du dorsal.",
