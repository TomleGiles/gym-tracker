    { "id": "ez_bar_curl", "label_fr": "Curl barre EZ", "equipment": "barbell", "mechanic": "isolation", "bar_weight_kg": 10,
      "cues": "La prise semi-pronation soulage le poignet. Même consigne : coudes fixes.",
      "primary": ["biceps_brachii"], "secondary": ["forearm_flexors"], "stabilizer": [] },
    { "id": "dumbbell_curl", "label_fr": "Curl haltères", "equipment": "dumbbell", "mechanic": "isolation",
      "cues": "Supine en montant : le biceps est aussi un supinateur.",
